TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# ID проекта (trs) в Travelpayouts с подключённой программой Островка — для партнёрских ссылок на отели (не путать с marker)
TRAVELPAYOUTS_TRS=

# Места на карте из выгрузок OpenStreetMap (docs/ops/osm-import.md); всё необязательно
# KLUBOK_OSM_DIR=data/osm
# KLUBOK_OSM_REGIONS=russia,asia/kazakhstan
# KLUBOK_OSMIUM=osmium
# KLUBOK_ENRICH_LIMIT=5000

# Кэш (Redis) и справочник городов карты — для цен на жильё (ADR-0021)
# KLUBOK_REDIS_URL=redis://127.0.0.1:6379/0
# KLUBOK_CITIES_FILE=frontend/public/data/cities.geojson
